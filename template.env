NAME=sbb-binarization
PORT=

LAREX_PROCESSOR_ID=
LAREX_DISPATCH_HMAC_SECRET=
LAREX_ALLOWED_CALLBACK_ORIGINS=["https://larex.example.com"]
LAREX_ROUTE_PREFIXES=["/action"]
LAREX_SDK_TRANSPORT_DEBUG=false

ACTION_DEBUG=false
ACTION_MAX_CONCURRENT_RUNS=1
ACTION_LOADING_TIMEOUT=60
ACTION_PAGE_TIMEOUT=30
ACTION_TIMEOUT_MODE='fail_page'

SBB_SUFFIX=.sbb.bin.png
SBB_DEVICE=cuda
SBB_MODEL_DIR=/path/to/models/directory
